# Your practice's Client Portal address. Either the slug or the full host —
# it is the host in the portal link your provider emailed you.
SIMPLEPRACTICE_PRACTICE=achievebalancetherapy

# Optional. Where to persist the signed-in session (written 0600).
# Deliberately NOT ~/.simplepractice-cookies, which the simplepractice-fpx
# skill uses for its curl cookie jar.
# SIMPLEPRACTICE_SESSION_FILE=~/.simplepractice-mcp/session.json
